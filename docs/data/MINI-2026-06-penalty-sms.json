  "title": "\uacfc\ud0dc\ub8cc \ubb38\uc790 \uc0ac\uae30 30\ucd08 \ubbf8\ub2c8 \ud6c8\ub828",
  "status": "draft_for_human_review",
  "simulation_notice": "\uc774 \ucf58\ud150\uce20\ub294 \uc2e4\uc81c \uace0\uc9c0\uc11c\ub098 \uae30\uad00 \uc5f0\ub77d\uc774 \uc544\ub2cc \ubcf4\uc548 \uad50\uc721\uc6a9 \ubaa8\uc758 \ud6c8\ub828\uc785\ub2c8\ub2e4. \uac1c\uc778\uc815\ubcf4, \uacc4\uc88c\uc815\ubcf4, \uc778\uc99d\ubc88\ud638\ub97c \uc785\ub825\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.",
  "estimated_duration": "30-60\ucd08",
  "audience": "\ubd80\ubaa8\ub2d8\uacfc \ubcf4\ud638\uc790, \uc77c\ubc18 \uc0ac\uc6a9\uc790, \uae30\uad00 \uad50\uc721 \ub2f4\ub2f9\uc790",
  "scenario": {
    "heading": "\ubaa8\uc758 \ubb38\uc790 \uc0c1\ud669",
    "body": "[\ubaa8\uc758 \ubb38\uc790]\n\uad50\ud1b5 \uacfc\ud0dc\ub8cc \ubbf8\ub0a9 \uc548\ub0b4\n\ud655\uc778\uc774 \ud544\uc694\ud55c \uace0\uc9c0 \ub0b4\uc5ed\uc774 \uc788\uc2b5\ub2c8\ub2e4.\n\uc544\ub798 \ub9c1\ud06c\uc5d0\uc11c \ub0a9\ubd80 \ub0b4\uc5ed\uc744 \ud655\uc778\ud558\uc138\uc694.\nexample-safe-training.kr/check\n\n\uc774 \ubb38\uc790\ub294 \uc2e4\uc81c \uacfc\ud0dc\ub8cc \uace0\uc9c0\uac00 \uc544\ub2cc \ud6c8\ub828 \uc608\uc2dc\uc785\ub2c8\ub2e4.",
    "question": "\uc774 \ubb38\uc790\ub97c \ubc1b\uc558\uc744 \ub54c \uac00\uc7a5 \uc548\uc804\ud55c \ud589\ub3d9\uc740 \ubb34\uc5c7\uc77c\uae4c\uc694?"
  },
  "choices": [
    {
      "id": "A",
      "text": "\ubb38\uc790\uc5d0 \uc788\ub294 \ub9c1\ud06c\ub97c \ub20c\ub7ec \ubc14\ub85c \ud655\uc778\ud55c\ub2e4.",
      "risk": "high",
      "feedback": "\uc704\ud5d8\ud569\ub2c8\ub2e4. \ubb38\uc790 \ub9c1\ud06c\ub294 \ud53c\uc2f1 \uc0ac\uc774\ud2b8\ub098 \uc545\uc131 \uc571 \uc124\uce58\ub85c \uc774\uc5b4\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
    },
    {
      "id": "B",
      "text": "\ubb38\uc790 \ub9c1\ud06c\ub97c \ub204\ub974\uc9c0 \uc54a\uace0, \uacf5\uc2dd \uc571\uc774\ub098 \uacf5\uc2dd \uc6f9\uc0ac\uc774\ud2b8\uc5d0\uc11c \uc9c1\uc811 \ud655\uc778\ud55c\ub2e4.",
      "risk": "low",
      "feedback": "\uc88b\uc2b5\ub2c8\ub2e4. \uae09\ud55c \ubb38\uc790\uc77c\uc218\ub85d \ub9c1\ud06c\ub97c \ub204\ub974\uae30\ubcf4\ub2e4 \uacf5\uc2dd \uacbd\ub85c\ub85c \uc9c1\uc811 \ud655\uc778\ud558\ub294 \uc2b5\uad00\uc774 \uc548\uc804\ud569\ub2c8\ub2e4."
    },
    {
      "id": "C",
      "text": "\ubb38\uc790\uc5d0 \uc801\ud78c \ubc88\ud638\ub85c \ubc14\ub85c \uc804\ud654\ud574 \ud655\uc778\ud55c\ub2e4.",
      "risk": "medium",
      "feedback": "\uc8fc\uc758\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \ubb38\uc790 \uc18d \ubc88\ud638\ub3c4 \uc870\uc791\ub420 \uc218 \uc788\uc73c\ub2c8 \uacf5\uc2dd \uace0\uac1d\uc13c\ud130 \ubc88\ud638\ub97c \uc9c1\uc811 \ucc3e\uc544 \ud655\uc778\ud558\uc138\uc694."
